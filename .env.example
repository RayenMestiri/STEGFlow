NODE_ENV=development
PORT=3000

# MongoDB Atlas — utilisateur dédié et liste IP limitée.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/stegflow?retryWrites=true&w=majority

# Redis alimente la file de notifications asynchrones.
REDIS_URL=redis://localhost:6379

# Cloudinary — ne commettez jamais la valeur réelle.
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

JWT_ACCESS_SECRET=generate-a-random-secret-of-at-least-32-characters
JWT_REFRESH_SECRET=generate-a-different-random-secret-of-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
SEED_DEMO_DATA=true

CORS_ORIGINS=http://localhost:4200,http://localhost:4201,http://localhost:4202
TRUST_PROXY=loopback
