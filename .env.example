POSTGRES_USER=steg
POSTGRES_PASSWORD=change-me
POSTGRES_DB=stegflow

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
SEED_DEMO_DATA=true

S3_REGION=us-east-1
S3_BUCKET=stegflow-media
S3_ACCESS_KEY=stegflow
S3_SECRET_KEY=change-me
S3_PUBLIC_URL=http://localhost:9000
# Optional for an S3 provider configured for SSE. Keep empty for local MinIO.
S3_SERVER_SIDE_ENCRYPTION=

# Firebase Cloud Messaging — ne jamais committer les vraies valeurs.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
