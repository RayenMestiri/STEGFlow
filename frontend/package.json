{
  "name": "stegflow-frontend",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start:admin": "npm run build:shared && ng serve admin --port 4200",
    "start:citizen": "npm run build:shared && ng serve citizen --port 4201",
    "start:maintenance": "npm run build:shared && ng serve maintenance --port 4202",
    "build:admin": "ng build admin",
    "build:citizen": "ng build citizen",
    "build:maintenance": "ng build maintenance",
    "build:shared": "ng build shared-data-access",
    "build:all": "npm run build:shared && npm run build:admin && npm run build:citizen && npm run build:maintenance",
    "build": "npm run build:all",
    "test": "npm run build:shared && ng test --watch=false"
  },
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/service-worker": "^21.2.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "lucide-angular": "^1.0.0",
    "maplibre-gl": "^6.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.19",
    "@angular/cli": "^21.2.19",
    "@angular/compiler-cli": "^21.2.0",
    "jsdom": "^28.0.0",
    "ng-packagr": "^21.2.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
